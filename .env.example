# Aura Mental Health Companion Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini Generative AI API Key (Optional - get from https://aistudio.google.com/)
# If left blank, Aura will automatically run with the built-in Offline CBT Empathy Engine.
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./mental_health.db
